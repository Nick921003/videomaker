# LLM 金鑰，擇一即可
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# 指定模型（不設就用 llm.py 的各階段預設）
# VIDEO_ENGINE_LLM=google:gemini-3.7-flash
# LLM_BASE_URL=http://127.0.0.1:8000/v1     本機 OpenAI 相容端點才需要

# 聲音服務：GPT-SoVITS 是獨立專案，這裡只透過 HTTP 呼叫
TTS_API_URL=http://127.0.0.1:9880/tts
TTS_REF_AUDIO=/絕對路徑/到/參考音訊.wav
TTS_REF_TEXT=參考音訊的逐字內容
