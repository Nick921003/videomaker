{
	"version": 1,
	"title": "C 迴圈：看懂每一輪",
	"tag": "共用教學規劃",
	"corner_note": "未配音 fixture",
	"objects": [
		{
			"id": "problem_pipeline",
			"type": "pipeline",
			"title": "一百次加法，怎樣少寫又算對？",
			"stages": [
				{
					"id": "s0",
					"label": "找出要重複的動作"
				},
				{
					"id": "s1",
					"label": "決定開始與繼續條件"
				},
				{
					"id": "s2",
					"label": "確認每輪更新與最後結果"
				}
			]
		},
		{
			"id": "trace_code",
			"type": "code",
			"lines": [
				"int n = 5, sum = 0;",
				"for (int i = 1; i <= n; i++) {",
				"    sum += i;",
				"}",
				"printf(\"%d\", sum);"
			],
			"caption": "跟著程式，看到累加值怎麼變"
		},
		{
			"id": "trace_vars",
			"type": "vars",
			"title": "目前變數",
			"vars": [
				{
					"id": "v0",
					"name": "i",
					"value": "1"
				},
				{
					"id": "v1",
					"name": "sum",
					"value": "1"
				}
			]
		},
		{
			"id": "trace_output",
			"type": "output",
			"label": "輸出"
		},
		{
			"id": "termination_pipeline",
			"type": "pipeline",
			"title": "狀態不更新，迴圈就可能停不下來",
			"stages": [
				{
					"id": "s0",
					"label": "檢查條件使用的變數"
				},
				{
					"id": "s1",
					"label": "找到主體裡的更新"
				},
				{
					"id": "s2",
					"label": "確認更新後能讓條件不成立"
				}
			]
		}
	],
