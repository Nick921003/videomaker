			"asr": {
				"ok": true,
				"problems": [],
				"missing": [],
				"heard": "第一种情况是数数如果要把1到5全部加起来起点是1"
			}
		},
		{
			"digest": "3c825e6199f7",
			"text": "我們要算到五，五本身必須算進去。",
			"ok": true,
			"total": 2.96,
