{
	"version": 1,
	"title": "把編譯器資料夾加進 PATH",
	"tag": "環境建立",
	"corner_note": "Windows 11 示意",
	"objects": [
		{
			"id": "search",
			"preset": "win11.search"
		},
		{
			"id": "sysprops",
			"preset": "win11.sys_props"
		},
		{
			"id": "envvars",
			"preset": "win11.env_vars"
		},
		{
			"id": "editpath",
			"preset": "win11.edit_env_var"
		},
		{
			"id": "keep_tip",
			"type": "note",
			"text": "原本的項目不要刪，三個視窗都要按「確定」",
			"style": "small"
		},
		{
			"id": "term",
			"type": "terminal",
			"title": "終端機（重新開啟）",
			"prompt": "C:\\cs101>"
		},
		{
			"id": "sample",
			"type": "note",
			"text": "版本號依安裝而不同（教材示例）",
			"style": "small"
		},
		{
			"id": "checks",
			"type": "list",
			"title": "還是出現「不是內部或外部命令」？",
			"rows": [
				"① 終端機整個重開（VS Code 也要）",
				"② 加的是資料夾，不是 gcc.exe",
				"③ 用 where gcc 看實際路徑"
			]
		},
		{
			"id": "mouse",
			"type": "cursor"
		}
	],
	"scenes": [
		{
			"id": "open",
			"title": "打開環境變數設定",
			"label": "① 搜尋設定",
			"layout": {
				"stack": [
					"search"
				]
			},
			"beats": [
				{
					"say": "按下 Windows 鍵，輸入「環境變數」，",
					"do": [
						{
							"act": "show",
							"target": "search"
						},
						{
							"act": "input",
							"target": "search:q",
							"text": "環境變數",
							"cue": "輸入"
						}
					]
				},
				{
					"say": "點選「編輯系統環境變數」。",
					"do": [
						{
							"act": "click",
							"target": "mouse",
							"on": "search:r0",
							"cue": "點選"
						}
					]
				}
			]
		},
		{
			"id": "props",
			"title": "系統內容：進階分頁",
			"label": "② 系統內容",
			"layout": {
				"stack": [
					"sysprops"
				]
			},
			"beats": [
				{
					"say": "跳出的視窗在「進階」分頁，",
					"do": [
						{
							"act": "show",
							"target": "sysprops"
						},
						{
							"act": "underline",
							"target": "sysprops:t_adv",
							"cue": "進階"
						}
					]
				},
				{
					"say": "按右下角的「環境變數」。",
					"do": [
						{
							"act": "click",
							"target": "mouse",
							"on": "sysprops:envbtn",
							"cue": "右下角"
						},
						{
							"act": "focus",
							"target": "sysprops:envbtn",
							"with": "prev"
						}
					]
				}
			]
		},
		{
			"id": "vars",
			"title": "選使用者變數的 Path",
			"label": "③ 環境變數",
			"layout": {
				"stack": [
					"envvars"
				]
			},
			"beats": [
				{
					"say": "在上方的使用者變數裡，選取 Path，",
					"spoken": "在上方的使用者變數裡，選取 path，",
					"do": [
						{
							"act": "show",
							"target": "envvars"
						},
						{
							"act": "focus",
							"target": "envvars:user",
							"with": "prev"
						},
						{
							"act": "click",
							"target": "mouse",
							"on": "envvars:u_path",
							"cue": "選取"
						}
					]
				},
				{
					"say": "再按「編輯」。下面的系統變數不用動。",
					"do": [
						{
							"act": "click",
							"target": "mouse",
							"on": "envvars:u_edit",
							"cue": "編輯"
						},
						{
							"act": "wide",
							"cue": "系統變數"
						},
						{
							"act": "circle",
							"target": "envvars:sys",
							"with": "prev"
						}
					]
				}
			]
		},
		{
			"id": "add",
			"title": "新增編譯器所在的資料夾",
			"label": "④ 新增路徑",
			"layout": {
				"stack": [
					"editpath",
					"keep_tip"
				]
			},
			"beats": [
				{
					"say": "按「新增」，貼上編譯器所在的資料夾，",
					"do": [
						{
							"act": "show",
							"target": "editpath"
						},
						{
							"act": "click",
							"target": "mouse",
							"on": "editpath:b_new",
							"cue": "新增"
						},
						{
							"act": "input",
							"target": "editpath:new",
							"text": "C:\\msys64\\ucrt64\\bin"
						},
						{
							"act": "focus",
							"target": "editpath:new",
							"with": "prev"
						}
					]
				},
				{
					"say": "原本的項目一個都不要刪。",
					"do": [
						{
							"act": "circle",
							"target": "editpath:r0",
							"cue": "原本"
						}
					]
				},
				{
					"say": "然後每個視窗都按「確定」，總共三次。",
					"do": [
						{
							"act": "wide",
							"cue": "然後"
						},
						{
							"act": "click",
							"target": "mouse",
							"on": "editpath:ok",
							"cue": "確定"
						},
						{
							"act": "write",
							"target": "keep_tip",
							"with": "prev"
						}
					]
				}
			]
		},
		{
			"id": "verify",
			"title": "重開終端機，驗證",
			"label": "⑤ 驗證",
			"layout": {
				"stack": [
					"term",
					"sample"
				]
			},
			"beats": [
				{
					"say": "最後一定要重開終端機，再輸入版本指令。",
					"do": [
						{
							"act": "show",
							"target": "term"
						},
						{
							"act": "type",
							"target": "term",
							"text": "gcc --version",
							"cue": "輸入"
						}
					]
				},
				{
					"say": "看到版本資訊，就代表設定成功。",
					"do": [
						{
							"act": "print",
							"target": "term",
							"lines": [
								"gcc (Rev1, Built by MSYS2 project) 13.2.0",
								"Copyright (C) 2023 Free Software Foundation, Inc."
							],
							"cue": "版本"
						},
						{
							"act": "write",
							"target": "sample",
							"with": "prev"
						}
					]
				}
			]
		},
		{
			"id": "debug",
			"title": "還是找不到？三個檢查",
			"label": "⑥ 除錯",
			"keep": [
				"term"
			],
			"layout": {
				"row": [
					"term",
					"checks"
				]
			},
			"beats": [
				{
					"say": "如果還是說找不到，先檢查三件事：",
					"do": [
						{
							"act": "show",
							"target": "checks"
						}
					]
				},
				{
					"say": "終端機要整個重開，VS Code 裡的也算。",
					"spoken": "終端機要整個重開，編輯器裡的終端機也算。",
					"do": [
						{
							"act": "underline",
							"target": "checks:r0",
							"cue": "重開"
						}
					]
				},
				{
					"say": "加的是資料夾，不是執行檔本身。",
					"do": [
						{
							"act": "underline",
							"target": "checks:r1",
							"cue": "資料夾"
						}
					]
				},
				{
					"say": "再用 where 指令，看系統實際找到哪一個。",
					"do": [
						{
							"act": "underline",
							"target": "checks:r2",
							"cue": "where"
						},
						{
							"act": "type",
							"target": "term",
							"text": "where gcc",
							"with": "prev"
						},
						{
							"act": "print",
							"target": "term",
							"lines": [
								"C:\\msys64\\ucrt64\\bin\\gcc.exe"
							],
							"cue": "實際"
						}
					]
				},
				{
					"say": "列出多個時，排第一的才會被執行。",
					"do": [
						{
							"act": "circle",
							"target": "term:line4",
							"cue": "第一"
						}
					]
				}
			]
		}
	]
}