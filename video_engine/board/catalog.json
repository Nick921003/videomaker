{
	"version": 1,
	"fallback_type": "note",
	"generic_actions": {
		"show": {"dur": 0.45},
		"hide": {"dur": 0.4},
		"circle": {"dur": 0.7},
		"underline": {"dur": 0.6},
		"arrow": {"dur": 0.8, "req": ["to"], "opt": ["label"], "anchor_args": ["to"]},
		"focus": {"dur": 0.9},
		"wide": {"dur": 0.9, "no_target": true}
	},
	"types": {
		"note": {
			"req": ["text"],
			"opt": ["style"],
			"styles": ["headline", "body", "accent", "code", "small"],
			"anchors": [],
			"actions": {
				"write": {"per_char": 0.06, "min": 0.6, "max": 1.6, "blocks": true}
			}
		},
		"cells": {
			"req": ["count"],
			"opt": ["label", "values", "tail", "index_labels"],
			"anchors": ["label", "i{n}"],
			"actions": {
				"fill": {"seq": "values", "per": [0.28, 0.6], "req": ["values"], "opt": ["from", "start"], "anchor_args": ["from"], "blocks": true},
				"scan": {"seq": "range", "per": [0.3, 0.9], "req": ["range"], "opt": ["to"], "anchor_args": ["to"], "blocks": true},
				"point": {"dur": 0.45, "req": ["index"], "blocks": true},
				"stop": {"dur": 0.8, "req": ["index"], "opt": ["note"], "blocks": true},
				"brace": {"dur": 0.9, "req": ["range", "label"], "blocks": true}
			}
		},
		"output": {
			"req": [],
			"opt": ["label", "max_text", "text"],
			"anchors": ["text", "end"],
			"actions": {
				"set": {"dur": 0.5, "req": ["text"], "blocks": true}
			}
		},
		"code": {
			"req": ["lines"],
			"opt": ["caption", "footer"],
			"anchors": ["L{n}"],
			"actions": {
				"highlight": {"dur": 0.5, "req": ["line"]}
			}
		},
		"metrics": {
			"req": ["items"],
			"opt": [],
			"anchors": ["m{n}"],
			"actions": {
				"reveal": {"seq": "items", "per": [0.3, 0.8], "blocks": true}
			}
		},
		"terminal": {
			"req": [],
			"opt": ["title", "prompt"],
			"anchors": ["cmd", "line{n}"],
			"actions": {
				"type": {"seq": "chars", "per": [0.035, 0.1], "req": ["text"], "blocks": true},
				"print": {"seq": "lines", "per": [0.2, 0.6], "req": ["lines"], "opt": ["style"], "blocks": true},
				"restart": {"dur": 1.2, "opt": ["note"], "blocks": true}
			}
		},
		"list": {
			"req": ["rows"],
			"opt": ["title"],
			"anchors": ["title", "r{n}"],
			"actions": {
				"walk": {"seq": "walk", "per": [0.35, 0.9], "opt": ["found", "item"], "blocks": true},
				"append": {"dur": 0.9, "req": ["text"], "blocks": true}
			}
		}
	}
}
