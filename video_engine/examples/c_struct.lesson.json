			"note": "依定義型態、宣告變數、點運算子存取、印出結果四步走讀；提醒姓名要用 strcpy。",
			"elements": [
				{
					"id": "p3_title",
					"type": "title",
					"text": "程式碼走讀"
				},
				{
					"id": "p3_sub",
					"type": "subtitle",
					"text": "定義、宣告、存取、輸出四個步驟"
				},
				{
					"id": "p3_code",
					"type": "code",
					"lang": "c",
					"lines": [
						"#include <stdio.h>",
						"#include <string.h>",
						"",
						"typedef struct {",
						"    char name[32];",
						"    int score;",
						"} Student;",
						"",
						"int main() {",
						"    Student s1;",
						"    strcpy(s1.name, \"Alice\");",
						"    s1.score = 95;",
						"    printf(\"name: %s, score: %d\\n\", s1.name, s1.score);",
						"    return 0;",
						"}"
					]
				}
			]
		},
