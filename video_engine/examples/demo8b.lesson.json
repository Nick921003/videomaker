					"id": "p3_sub",
					"type": "subtitle",
					"text": "宣告、複製、量長度、印出"
				},
				{
					"id": "p3_code",
					"type": "code",
					"lang": "c",
					"lines": [
						"#include <stdio.h>",
						"#include <string.h>",
						"",
						"int main() {",
						"    char name[32];",
						"    strcpy(name, \"Alice\");",
						"    printf(\"%s 共 %d 個字\\n\", name, (int)strlen(name));",
						"    return 0;",
						"}"
					]
				}
			]
		},
