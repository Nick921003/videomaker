					"lines": [
						"#include <stdio.h>",
						"",
						"int main() {",
						"    int n = 5, sum = 0;",
						"    for (int i = 1; i <= n; i++) {",
						"        sum += i;",
						"    }",
						"    printf(\"1 加到 %d 等於 %d\\n\", n, sum);",
						"    return 0;",
						"}"
