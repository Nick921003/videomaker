				},
				{
					"id": "p3_code",
					"type": "code",
					"lang": "c",
					"lines": [
						"#include <stdio.h>",
						"#include <string.h>",
						"",
						"typedef struct {",
						"    char name[32];",
						"    int score;",
						"} Student;",
						"",
						"int main() {",
						"    Student s1;",
						"    strcpy(s1.name, \"Alice\");",
						"    s1.score = 95;",
						"    printf(\"name: %s, score: %d\\n\", s1.name, s1.score);",
						"    return 0;",
						"}"
					]
				}
			]
		},
