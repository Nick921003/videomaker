					"id": "p4_sub",
					"type": "subtitle",
					"text": "四個步驟把字串放進陣列並印出"
				},
				{
					"id": "p4_code",
					"type": "code",
					"lang": "c",
					"lines": [
						"#include <stdio.h>",
						"#include <string.h>",
						"",
						"int main() {",
						"    char name[32];",
						"    strcpy(name, \"Alice\");",
						"    printf(\"%s 共 %d 個字\\n\",",
						"           name, (int)strlen(name));",
						"    return 0;",
						"}"
					]
				}
			]
		},
